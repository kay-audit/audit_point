# === Безопасность ===
SECURITY__MAX_REQUEST_SIZE=10485760
SECURITY__RATE_LIMIT_PER_MINUTE=1024
SECURITY__MAX_TRACKED_IPS=100
SECURITY__RATE_LIMIT_TTL=120
SECURITY__SINGLETON_LOCK_STALE_TTL_SEC=60

# === Security-заголовки ===
SECURITY__CSP_ENABLED=true
SECURITY__CSP_REPORT_ONLY=false
SECURITY__HSTS_ENABLED=true
SECURITY__HSTS_MAX_AGE=31536000
SECURITY__HSTS_INCLUDE_SUBDOMAINS=true
SECURITY__FRAME_OPTIONS=SAMEORIGIN
SECURITY__REFERRER_POLICY=strict-origin-when-cross-origin

# === Observability (метрики в БД) ===
OBSERVABILITY__METRICS_BATCH_SIZE=100
OBSERVABILITY__METRICS_FLUSH_INTERVAL_SEC=5.0
OBSERVABILITY__METRICS_MAX_BUFFER_SIZE=10000

# === Домен: AI-чат ===
# CHAT__SCHEMA_NAME= # пусто → основная схема адаптера
# --- Маршрут LLM-провайдера (см. docs/integrations/redis-llm-bridge.md):
#   gigachat              — напрямую в GigaChat API (нужны API_BASE/API_KEY)
#   openai                — напрямую в OpenAI-совместимый сервер: sglang, vLLM,
#                           openrouter и т.п. (нужны API_BASE/API_KEY)
#   redis-bridge,gigachat — через Redis-воркер на DataLab к GigaChat
#   redis-bridge,openai   — через Redis-воркер к OpenAI-совместимому серверу
#                           (API_BASE/API_KEY не нужны — транспорт на Redis)
# ПРОМ — через Redis-мост (с SDP нет прямого сетевого доступа к DataLab).
# Другие маршруты и детали — developer-guide §9.4.1 ---
CHAT__PROFILE=redis-bridge,gigachat
CHAT__MODEL=GigaChat-3-Ultra
# Для HTTP-маршрутов (gigachat | openai) API_BASE/API_KEY обязательны;
# для redis-bridge-маршрутов не используются — можно оставить пустыми.
# CHAT__API_KEY=${JPY_API_TOKEN} — можно сослаться на переменную окружения
# (интерполяция ${VAR} в .env, developer-guide §9.4.1).
# CHAT__API_BASE=
# CHAT__API_KEY=
CHAT__TEMPERATURE=0.1
CHAT__REQUEST_TIMEOUT=180

# --- Retry для transient-ошибок LLM (4xx кроме 429 не повторяются) ---
CHAT__RETRY__ON_429=true
CHAT__RETRY__ON_5XX=true
CHAT__RETRY__MAX_ATTEMPTS=5
CHAT__RETRY__BACKOFF_BASE_SEC=2.0
CHAT__RETRY__CONNECT_MAX_ATTEMPTS=2

# --- Оркестрация ---
CHAT__SMALLTALK_MODE=local
CHAT__SYSTEM_PROMPT=Ты — AI-ассистент в едином рабочем месте. Помогаешь с анализом актов, поиском информации и ответами на вопросы. Отвечай на русском языке, кратко и по делу.
CHAT__MAX_TOOL_ROUNDS=5
CHAT__TOOL_EXECUTION_TIMEOUT=30
CHAT__MAX_HISTORY_LENGTH=50
CHAT__MAX_MESSAGE_CONTENT_LENGTH=10000
CHAT__HISTORY_FULL_CONTEXT_DEPTH=5

# --- Лимиты на пользователя ---
CHAT__RATE_LIMIT_MESSAGES_PER_MINUTE_PER_USER=10
CHAT__MAX_PARALLEL_STREAMS_PER_USER=3

# --- Fallback-маршрут (тот же формат, что CHAT__PROFILE; пусто = отключён).
#     Для redis-bridge-маршрутов FALLBACK_API_BASE/FALLBACK_API_KEY не нужны,
#     для HTTP-маршрутов — обязательны; circuit breaker + health-probe
#     работают одинаково ---
CHAT__FALLBACK_PROFILE=redis-bridge,openai
CHAT__FALLBACK_MODEL=Qwen3-8B
# CHAT__FALLBACK_API_BASE=
# CHAT__FALLBACK_API_KEY=
CHAT__CIRCUIT_BREAKER_FAILURE_THRESHOLD=2
CHAT__CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SEC=60
CHAT__HEALTH_PROBE__ENABLED=true
CHAT__HEALTH_PROBE__POLL_MIN_INTERVAL_SEC=2.0
CHAT__HEALTH_PROBE__POLL_MAX_INTERVAL_SEC=30.0
CHAT__HEALTH_PROBE__POLL_BACKOFF_MULTIPLIER=1.5
CHAT__HEALTH_PROBE__TIMEOUT_SEC=5.0

# --- Redis-мост LLM: транспорт для redis-bridge-маршрутов (docs/integrations/redis-llm-bridge.md) ---
CHAT__REDIS_BRIDGE__KEY_PREFIX=llm:bridge: # префикс ключей моста в Redis (менять не нужно)

# --- Файлы ---
CHAT__MAX_FILE_SIZE=10485760
CHAT__MAX_FILES_PER_MESSAGE=5
CHAT__MAX_TOTAL_FILE_SIZE=31457280

# --- Хранение ---
CHAT__MAX_CONVERSATIONS_PER_USER=100
CHAT__MAX_MESSAGES_PER_CONVERSATION=500

# --- Канал к внешнему ИИ-агенту (bus-таблица, polling-only) ---
# CHAT__AGENT_CHANNEL__SCHEMA_NAME= # пусто → схема чата → основная
CHAT__AGENT_CHANNEL__TABLE_NAME=agent_conversation_messages
CHAT__AGENT_CHANNEL__POLL_MIN_INTERVAL_SEC=2.0
CHAT__AGENT_CHANNEL__POLL_MAX_INTERVAL_SEC=10.0
CHAT__AGENT_CHANNEL__POLL_BACKOFF_MULTIPLIER=1.5
CHAT__AGENT_CHANNEL__ANSWER_TIMEOUT_SEC=600
CHAT__AGENT_CHANNEL__CLAIM_TIMEOUT_SEC=1800
CHAT__AGENT_CHANNEL__MAX_BLOCK_TEXT_SIZE=262144

