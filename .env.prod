# === Redis (общая инфраструктура: ОТП-коды, локи актов, кэши) ===
REDIS__HOST=10.110.10.38
REDIS__PORT=7474
REDIS__DB=0
# REDIS__PASSWORD= # пусто — Redis без пароля
REDIS__MAX_CONNECTIONS=10
