AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ACCESS_TTL=900
AUTH__JWT_REFRESH_TTL=604800
AUTH__COOKIE_SECURE=false
# AUTH__COOKIE_DOMAIN= # пусто — без ограничения домена
AUTH__OTP_LENGTH=6
AUTH__OTP_TTL=300
AUTH__OTP_MAX_ATTEMPTS=5
